    /* Retention-1N-Mode Leakage Power */
    leakage_power() {
      related_pg_pin : "VDDPE";
      when :"!RET1N";
      value : 0.012539;
    }
    leakage_power() {
      related_pg_pin : "VDDCE";
      when :"!RET1N";
      value : 0.51254;
    }
    /* Default Leakage Power */
    leakage_power() {
      related_pg_pin : "VDDPE";
      value : 0.113029;
    }
    leakage_power() {
      related_pg_pin : "VDDCE";
      value : 0.509107;
    }
