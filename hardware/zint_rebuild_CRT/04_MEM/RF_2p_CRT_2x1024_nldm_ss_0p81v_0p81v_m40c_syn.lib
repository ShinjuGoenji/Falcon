    leakage_power() {
      related_pg_pin : "VDDPE";
      when :"!RET1N";
      value : 1.586e-03;
    }
    leakage_power() {
      related_pg_pin : "VDDCE";
      when :"!RET1N";
      value : 0.138003;
    }
