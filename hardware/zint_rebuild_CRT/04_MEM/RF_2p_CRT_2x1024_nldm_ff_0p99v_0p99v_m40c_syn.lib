    /* Retention-1N-Mode Leakage Power */
    leakage_power() {
      related_pg_pin : "VDDPE";
      when :"!RET1N";
      value : 0.010946;
    }
    leakage_power() {
      related_pg_pin : "VDDCE";
      when :"!RET1N";
      value : 1.054131;
    }
    /* Default Leakage Power */
    leakage_power() {
      related_pg_pin : "VDDPE";
      value : 0.181136;
    }
    leakage_power() {
      related_pg_pin : "VDDCE";
      value : 1.035251;
    }
  }
